# DbnSpool worker. Build from the repository root:
#   docker build -f Dockerfile.spool -t dbnspool .

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props nuget.config .editorconfig ./
COPY Aspire/ServiceDefaults/ Aspire/ServiceDefaults/
COPY Core/ Core/

RUN dotnet publish Core/DbnSpool/DbnSpool.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

# Owned by the app user, so a named volume mounted here starts writable.
RUN mkdir /work && chown $APP_UID /work

COPY --from=build /app .

# The base image already listens on 8080.
ENV DbnSpool__WorkPath=/work

USER $APP_UID
EXPOSE 8080
VOLUME /work

ENTRYPOINT ["dotnet", "DbnSpool.dll"]
