# Copy to .env beside docker-compose.yml. .env holds secrets and is never committed.

# Databento: your API key. Unless the spend policy at the end says otherwise,
# DbnSync submits a job only when Databento quotes it at exactly $0.
DATABENTO_API_KEY=

# The S3 server's root credentials. scripts/fill-secrets.sh in the deploy skill
# generates the secret, or use: openssl rand -hex 24
S3_ROOT_ACCESS_KEY=dbnsync-admin
S3_ROOT_SECRET_KEY=

# A NAS folder for the archive. The RustFS container runs as uid 10001,
# so that user needs write access to it. On a machine that already runs DbnSync,
# this must be a different folder.
S3_DATA_PATH=/volume1/docker/dbnsync/s3

# Seq, the log server: the admin password for its first start.
SEQ_ADMIN_PASSWORD=

# Seq as a browser reaches it, so the dashboard can link issues to their logs.
DBNSYNC_LOGS_URL=http://nas.local:5341

# Optional, for reaching S3 and the dashboard from the internet over HTTPS
# (--profile internet): DNS names pointing at your home's public IP. Set both,
# or Caddy won't start.
# S3_DOMAIN=s3.example.com
# DASHBOARD_DOMAIN=dbnsync.example.com
#
# The dashboard's user name and password hash. Make the hash, base64-encoded
# so .env leaves its $ signs alone, with:
#   docker run --rm caddy:2.10.2 caddy hash-password --plaintext 'the password' | base64 -w0
# DASHBOARD_USER=
# DASHBOARD_PASSWORD_HASH=

# Optional: a least-privilege key for the worker (read-write on the bucket
# only), made in the S3 console. Falls back to the root key when unset.
# DBNSYNC_ACCESS_KEY=
# DBNSYNC_SECRET_KEY=

# Optional overrides, with their defaults:
# COMPOSE_PROJECT_NAME=dbnsync    a different name for a second copy on one machine
# S3_BUCKET=dbn
# S3_SERVICE_URL=http://s3:9000    or another S3 store, such as https://nyc3.digitaloceanspaces.com
# S3_PORT=9000
# S3_CONSOLE_PORT=9001
# DBNSYNC_PORT=8080
# SEQ_PORT=5341
# HTTPS_PORT=8443
# DBNSYNC_IMAGE=ghcr.io/squideyes/dbnsync-worker:latest
# DBNSYNC_ROOTS=ES,MES,NQ,MNQ,YM,MYM,RTY,M2K,CL,MCL,GC,MGC
# DBNSYNC_SCHEMAS=mbo,ohlcv-1s,definition,statistics,status

# Spend policy. Leave these alone to spend nothing: by default DbnSync submits
# a job only when Databento quotes it at exactly $0.
#
# CAUTION: paid jobs are billed by Databento to your account. DbnSync checks
# each quote against these limits and its own ledger of what it has spent, but
# it is provided as is, with no warranty (MIT licence): a bug, a price change
# or a mistaken setting can cost real money, and that risk is yours. Watch your
# Databento billing page, and set no limit higher than you can afford to lose.
#
# Paid jobs need ALL of these: ALLOW_PAID_JOBS=true and three limits in US
# dollars above 0, nested so per job <= per day <= per month. DbnSync refuses
# to start on anything half set.
# DBNSYNC_ALLOW_PAID_JOBS=false
# DBNSYNC_MAX_PER_JOB=0
# DBNSYNC_MAX_PER_DAY=0
# DBNSYNC_MAX_PER_MONTH=0
