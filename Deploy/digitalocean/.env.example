# Copy to .env beside docker-compose.yml. .env holds secrets and is never committed.

# Databento: your API key. Unless a spend limit below says otherwise, DbnSync
# submits a job only when Databento quotes it at exactly $0.
DATABENTO_API_KEY=

# The Space that holds the archive: its region's endpoint, and its name.
SPACES_URL=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=dbn

# A Spaces key that can read and write that Space.
DBNSYNC_ACCESS_KEY=
DBNSYNC_SECRET_KEY=

# Seq, the log server: the admin password for its first start.
SEQ_ADMIN_PASSWORD=

# Only for DbnSpool, the optional tape worker (--profile spool): a second Space
# for tapes, and a Spaces key with Read on the archive's Space and
# Read/Write/Delete on the tapes' Space, in both pairs of lines.
# SPACES_TAPES_BUCKET=dbn-tapes
# DBNSPOOL_ARCHIVE_ACCESS_KEY=
# DBNSPOOL_ARCHIVE_SECRET_KEY=
# DBNSPOOL_TAPES_ACCESS_KEY=
# DBNSPOOL_TAPES_SECRET_KEY=

# Optional overrides, with their defaults:
# DBNSYNC_IMAGE=ghcr.io/squideyes/dbnsync-worker:latest
# DBNSPOOL_IMAGE=ghcr.io/squideyes/dbnspool-worker:latest
# DBNSYNC_ROOTS=ES,MES,NQ,MNQ,YM,MYM,RTY,M2K,CL,MCL,GC,MGC
# DBNSYNC_SCHEMAS=mbo,ohlcv-1s,definition,statistics,status
# DBNSPOOL_ROOTS=ES,MES,NQ,MNQ,YM,MYM,RTY,M2K,CL,MCL,GC,MGC

# Spend policy. Leave these alone to spend nothing. Paid jobs are billed by
# Databento to your account, at your own risk: DbnSync is provided as is, with
# no warranty, and a bug, a price change or a mistaken setting can cost real money.
# DBNSYNC_ALLOW_PAID_JOBS=false
# DBNSYNC_MAX_PER_JOB=0
# DBNSYNC_MAX_PER_DAY=0
# DBNSYNC_MAX_PER_MONTH=0
