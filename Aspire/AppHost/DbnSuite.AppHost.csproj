       build targets and Aspire.Hosting.Dotnet for AddDotnetProject. The dashboard
       and orchestrator come from the Aspire CLI, so run it with `aspire run`. -->
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <PackageReference Include="Aspire.Hosting.Seq" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>20a6eaac-2a40-4f58-81db-4270c4dd1759</UserSecretsId>
  </PropertyGroup>

</Project>
