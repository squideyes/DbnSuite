@code {
    private const string SpoolEnv = """
        SPACES_TAPES_BUCKET=dbn-tapes
        DBNSPOOL_ARCHIVE_ACCESS_KEY=<the read-only key for the archive>
        DBNSPOOL_ARCHIVE_SECRET_KEY=<its secret>
        DBNSPOOL_TAPES_ACCESS_KEY=<the read-write key for tapes>
        DBNSPOOL_TAPES_SECRET_KEY=<its secret>
        """;

    private const string SpoolStart = """
        docker compose --profile spool pull
        docker compose --profile spool up -d
        """;

    private const string Pull = """
        dbnf login --profile tapes --location https://nyc3.digitaloceanspaces.com --bucket dbn-tapes
        dbnf tape pull ES --profile tapes --tapes D:\Tapes --from 2026-10-01 --kind l1
        """;
}
