<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dbnf</AssemblyName>
    <RootNamespace>DbnFetch</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dbnf</ToolCommandName>
    <PackageId>DbnSuite.Fetch</PackageId>
    <Description>DbnFetch (dbnf): download raw and processed market data from a DbnSync archive of Databento® files. An independent project with no official connection with Databento, Inc., owner of the registered Databento trademark; for use only as your Databento agreements allow. Provided as is, at your own risk: see NOTICE.md.</Description>
    <PublishAot>true</PublishAot>
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;osx-arm64;linux-x64;any</ToolPackageRuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbnSuite.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbnSuite.Client\DbnSuite.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

</Project>
