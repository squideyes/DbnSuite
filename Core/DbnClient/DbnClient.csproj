<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>DbnClient</PackageId>
    <Description>DbnClient: reads a DbnSync archive of Databento® files: raw days, continuous series, sessions, bars, conversions and compact tapes for backtesting. An independent project with no official connection with Databento, Inc., owner of the registered Databento trademark; for use only as your Databento agreements allow. Provided as is, at your own risk: see NOTICE.md.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbnSync.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

</Project>
